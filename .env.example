TELEGRAM_BOT_TOKEN=8704432083:AAEjDgBpFxTdqrfzxNYdOEu8eILKGgL6ha0
ADMIN_TELEGRAM_IDS=8942458232

# ==== SERVER ====
PORT=3000
# Public HTTPS URL where this server is reachable (needed for Paytm callback + payment page)
# e.g. https://yourdomain.com  (use ngrok/cloudflared while testing locally)
BASE_URL=https://yourdomain.com

# ==== ADMIN PANEL ====
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# ==== PAYTM MERCHANT (fill from your Paytm Business Dashboard) ====
# Get these from https://dashboard.paytm.com/next/apikeys (Payment Gateway product)
PAYTM_MID=YOUR_MID_HERE
PAYTM_MERCHANT_KEY=YOUR_MERCHANT_KEY_HERE
PAYTM_WEBSITE=WEBSTAGING
# WEBSTAGING for testing, DEFAULT (or your onboarded website name) for production
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE=Retail
# Use securegw-stage.paytm.in for testing, securegw.paytm.in for production
PAYTM_ENV=stage
